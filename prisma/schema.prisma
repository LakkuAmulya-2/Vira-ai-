generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole { STUDENT PARENT COUNSELOR ADMIN }
enum EducationStage { AFTER_10 AFTER_12 UNDERGRADUATE OTHER }
enum VerificationStatus { UNVERIFIED PENDING VERIFIED EXPIRED REJECTED }
enum Gender { FEMALE MALE NON_BINARY PREFER_NOT_TO_SAY }
enum SourceType { GOVERNMENT UNIVERSITY INSTITUTION EXAM_BODY SCHOLARSHIP_PROVIDER REGULATOR OTHER }
enum KnowledgeEntityType { CAREER COURSE COLLEGE PROGRAM EXAM SCHOLARSHIP ELIGIBILITY_RULE DEADLINE }
enum PublicationStatus { DRAFT PUBLISHED ARCHIVED }
enum DegreeLevel { CERTIFICATE DIPLOMA ASSOCIATE BACHELOR MASTER DOCTORATE OTHER }

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  student       StudentProfile?
  auditLogs     AuditLog[]
}

model StudentProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime?
  gender                Gender?
  countryCode           String         @db.VarChar(2)
  state                 String?
  city                  String?
  educationStage        EducationStage
  preferredCountries    String[]
  preferredLanguages    String[]
  budgetCurrency        String?        @db.VarChar(3)
  annualBudgetMinor     BigInt?
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  academicRecords       AcademicRecord[]
  interests             StudentInterest[]
  skills                StudentSkill[]
  goals                 CareerGoal[]
}

model AcademicRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       String
  board       String?
  institution String?
  percentage  Decimal? @db.Decimal(5,2)
  score       Decimal? @db.Decimal(10,2)
  maxScore    Decimal? @db.Decimal(10,2)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([studentId, level])
}

model StudentInterest {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  @@unique([studentId, name])
}

model StudentSkill {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String
  proficiency Int?
  createdAt   DateTime @default(now())
  @@unique([studentId, name])
}

model CareerGoal {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  @@unique([studentId, title])
}

model DataSource {
  id                 String             @id @default(cuid())
  name               String
  baseUrl            String             @unique
  sourceType         SourceType
  countryCode        String?            @db.VarChar(2)
  jurisdiction       String?
  verificationStatus VerificationStatus @default(PENDING)
  lastVerifiedAt     DateTime?
  validUntil         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          SourceDocument[]
  claims             KnowledgeClaim[]
}

model SourceDocument {
  id             String             @id @default(cuid())
  sourceId       String
  source         DataSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url            String             @unique
  title          String?
  contentHash    String?
  fetchedAt      DateTime?
  publishedAt    DateTime?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  status         VerificationStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  claims         KnowledgeClaim[]
  @@index([sourceId, status])
}

model KnowledgeClaim {
  id             String              @id @default(cuid())
  entityType     KnowledgeEntityType
  entityKey      String
  field          String
  value          Json
  sourceId       String
  source         DataSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  documentId     String?
  document       SourceDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  jurisdiction   String?
  countryCode    String?             @db.VarChar(2)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  status         VerificationStatus  @default(PENDING)
  verifiedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  @@index([entityType, entityKey, status])
  @@index([effectiveUntil, status])
}

model Career {
  id              String            @id @default(cuid())
  slug            String            @unique
  status          PublicationStatus @default(DRAFT)
  name            String
  summary         String?
  countryCode     String?           @db.VarChar(2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  pathways        CareerCourse[]
}

model Course {
  id              String            @id @default(cuid())
  slug            String            @unique
  status          PublicationStatus @default(DRAFT)
  name            String
  degreeLevel     DegreeLevel?
  field           String?
  durationMonths  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  careers         CareerCourse[]
  programs        Program[]
}

model CareerCourse {
  careerId String
  courseId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([careerId, courseId])
}

model College {
  id              String            @id @default(cuid())
  slug            String            @unique
  status          PublicationStatus @default(DRAFT)
  name            String
  countryCode     String            @db.VarChar(2)
  state           String?
  city            String?
  website         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  programs        Program[]
}

model Program {
  id              String            @id @default(cuid())
  collegeId       String
  courseId        String
  status          PublicationStatus @default(DRAFT)
  officialName    String
  durationMonths  Int?
  currency        String?           @db.VarChar(3)
  tuitionMinor    BigInt?
  college         College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@unique([collegeId, officialName])
}

model EntranceExam {
  id              String            @id @default(cuid())
  slug            String            @unique
  status          PublicationStatus @default(DRAFT)
  name            String
  countryCode     String            @db.VarChar(2)
  officialUrl     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Scholarship {
  id              String            @id @default(cuid())
  slug            String            @unique
  status          PublicationStatus @default(DRAFT)
  name            String
  providerName    String
  countryCode     String            @db.VarChar(2)
  officialUrl     String?
  currency        String?           @db.VarChar(3)
  awardMinor      BigInt?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}